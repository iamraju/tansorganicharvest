<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site.Master.cs"
    Inherits="TansOrganicHarvest.Site" %>
<%@ Register Src="~/Controls/NavigationMenu.ascx" TagPrefix="uc" TagName="Nav" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tan's Organic Harvest</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        forest:  { DEFAULT: '#2d6a4f', dark: '#1b4332', light: '#52b788' },
                        sage:    { DEFAULT: '#95d5b2', light: '#d8f3dc' },
                        cream:   { DEFAULT: '#fefae0', dark: '#fdf5c0' },
                        earth:   { DEFAULT: '#b7894a', light: '#e9c46a' },
                    },
                    fontFamily: {
                        display: ['"Playfair Display"', 'Georgia', 'serif'],
                        body:    ['"DM Sans"', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap"
          rel="stylesheet" />

    <style>
        * { font-family: 'DM Sans', sans-serif; }

        /* Organic texture overlay */
        .texture-bg {
            background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%232d6a4f' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
        }

        /* Leaf decoration */
        .leaf-divider::before {
            content: '🌿';
            display: block;
            text-align: center;
            font-size: 1.5rem;
            margin-bottom: 0.5rem;
        }

        /* Smooth nav underline */
        .nav-link-pub {
            position: relative;
        }
        .nav-link-pub::after {
            content: '';
            position: absolute;
            bottom: -2px; left: 0; right: 0;
            height: 2px;
            background: #52b788;
            transform: scaleX(0);
            transition: transform 0.25s ease;
            border-radius: 2px;
        }
        .nav-link-pub:hover::after,
        .nav-link-pub.active::after { transform: scaleX(1); }

        /* Button hover lift */
        .btn-lift {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .btn-lift:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(45,106,79,0.25);
        }

        /* Card hover */
        .product-card-hover {
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }
        .product-card-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.10);
        }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #52b788; border-radius: 3px; }
    </style>

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body class="bg-cream font-body text-gray-800 antialiased">
<form id="MainForm" runat="server">

    <!-- ── ANNOUNCEMENT BAR ───────────────────────────── -->
    <div class="bg-forest text-white text-center text-xs py-2 px-4">
        🚜 Free delivery on orders over $50 · Farm pickup Tue–Sat 8am–1pm
        <a href="FAQ.aspx" class="underline ml-2 hover:text-sage-light">Learn more</a>
    </div>

    <!-- ── HEADER ─────────────────────────────────────── -->
    <header class="bg-white/90 backdrop-blur-md sticky top-0 z-50 
                   border-b border-sage/30 shadow-sm">
        <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">

            <!-- Logo -->
            <a href="Default.aspx" class="flex items-center gap-3 group">
                <div class="w-10 h-10 bg-forest rounded-xl flex items-center 
                            justify-center text-xl group-hover:bg-forest-dark 
                            transition-colors">
                    🌿
                </div>
                <div>
                    <p class="font-display font-bold text-forest text-lg leading-tight">
                        Tan's Organic
                    </p>
                    <p class="text-xs text-gray-400 leading-tight tracking-widest uppercase">
                        Harvest
                    </p>
                </div>
            </a>

            <!-- Desktop Nav -->
            <uc:Nav ID="Nav1" runat="server" />

            <!-- Right actions -->
            <div class="flex items-center gap-3">

                <!-- Cart icon (member only) -->
                <a href="Members/Cart.aspx"
                   class="relative flex items-center justify-center w-10 h-10 
                          rounded-xl hover:bg-sage/20 transition-colors text-forest">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                    <!-- Cart count badge -->
                    <asp:Panel ID="pnlCartBadge" runat="server" Visible="false">
                        <span class="absolute -top-1 -right-1 bg-earth text-white 
                                     text-xs w-4 h-4 rounded-full flex items-center 
                                     justify-center font-bold">
                            <asp:Literal ID="litCartCount" runat="server" />
                        </span>
                    </asp:Panel>
                </a>

                <!-- Auth buttons -->
                <asp:LoginView ID="LoginView1" runat="server">
                    <AnonymousTemplate>
                        <a href="Account/Login.aspx"
                           class="text-sm text-forest font-medium hover:text-forest-dark 
                                  transition-colors px-3 py-2">
                            Sign In
                        </a>
                        <a href="Account/Register.aspx"
                           class="bg-forest text-white text-sm font-medium px-4 py-2 
                                  rounded-xl hover:bg-forest-dark transition-colors 
                                  btn-lift inline-block">
                            Join Free
                        </a>
                    </AnonymousTemplate>
                    <LoggedInTemplate>
                        <div class="flex items-center gap-2">
                            <a href="Members/Profile.aspx"
                               class="text-sm text-gray-600 hover:text-forest transition-colors">
                                👤 <asp:LoginName ID="LoginName1" runat="server" />
                            </a>
                            <asp:LoginStatus ID="LoginStatus1" runat="server"
                                LogoutText="Sign Out"
                                LogoutPageUrl="Default.aspx"
                                CssClass="text-sm text-red-500 hover:text-red-700 
                                          transition-colors ml-2" />
                        </div>
                    </LoggedInTemplate>
                </asp:LoginView>

                <!-- Mobile menu toggle -->
                <button type="button" onclick="toggleMobileMenu()"
                        class="md:hidden flex items-center justify-center w-10 h-10 
                               rounded-xl hover:bg-sage/20 transition-colors text-forest">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Mobile menu -->
        <div id="mobileMenu" class="hidden md:hidden bg-white border-t border-sage/20 px-6 py-4">
            <nav class="flex flex-col gap-3">
                <a href="Default.aspx"      class="text-sm font-medium text-gray-700 hover:text-forest">Home</a>
                <a href="Shop.aspx"         class="text-sm font-medium text-gray-700 hover:text-forest">Shop</a>
                <a href="ProduceBoxes.aspx" class="text-sm font-medium text-gray-700 hover:text-forest">Weekly Boxes</a>
                <a href="About.aspx"        class="text-sm font-medium text-gray-700 hover:text-forest">Our Farm</a>
                <a href="FAQ.aspx"          class="text-sm font-medium text-gray-700 hover:text-forest">FAQ</a>
                <a href="Contact.aspx"      class="text-sm font-medium text-gray-700 hover:text-forest">Contact</a>
            </nav>
        </div>
    </header>

    <!-- ── MAIN CONTENT ───────────────────────────────── -->
    <main>
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </main>

    <!-- ── FOOTER ─────────────────────────────────────── -->
    <footer class="bg-forest-dark text-white mt-20">
        <div class="max-w-7xl mx-auto px-6 py-16">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">

                <!-- Brand -->
                <div class="md:col-span-1">
                    <div class="flex items-center gap-2 mb-4">
                        <span class="text-2xl">🌿</span>
                        <span class="font-display font-bold text-lg">
                            Tan's Organic Harvest
                        </span>
                    </div>
                    <p class="text-sage text-sm leading-relaxed">
                        A family farm growing fresh, chemical-free produce since 1998.
                    </p>
                </div>

                <!-- Shop -->
                <div>
                    <h4 class="font-semibold text-sm uppercase tracking-widest 
                               text-sage mb-4">Shop</h4>
                    <ul class="space-y-2 text-sm text-white/70">
                        <li><a href="Shop.aspx" class="hover:text-white transition-colors">All Products</a></li>
                        <li><a href="ProduceBoxes.aspx" class="hover:text-white transition-colors">Weekly Boxes</a></li>
                        <li><a href="Shop.aspx?cat=1" class="hover:text-white transition-colors">Fresh Fruits</a></li>
                        <li><a href="Shop.aspx?cat=2" class="hover:text-white transition-colors">Vegetables</a></li>
                        <li><a href="Shop.aspx?cat=3" class="hover:text-white transition-colors">Honey &amp; Jams</a></li>
                    </ul>
                </div>

                <!-- Help -->
                <div>
                    <h4 class="font-semibold text-sm uppercase tracking-widest 
                               text-sage mb-4">Help</h4>
                    <ul class="space-y-2 text-sm text-white/70">
                        <li><a href="FAQ.aspx"     class="hover:text-white transition-colors">FAQ</a></li>
                        <li><a href="Contact.aspx" class="hover:text-white transition-colors">Contact Us</a></li>
                        <li><a href="About.aspx"   class="hover:text-white transition-colors">Our Farm</a></li>
                        <li><a href="Members/OrderHistory.aspx" class="hover:text-white transition-colors">Track Order</a></li>
                    </ul>
                </div>

                <!-- Contact -->
                <div>
                    <h4 class="font-semibold text-sm uppercase tracking-widest 
                               text-sage mb-4">Visit Us</h4>
                    <ul class="space-y-3 text-sm text-white/70">
                        <li class="flex gap-2">
                            <span>📍</span>
                            <span>123 Harvest Lane, Green Valley</span>
                        </li>
                        <li class="flex gap-2">
                            <span>📞</span>
                            <span>+60 12-345 6789</span>
                        </li>
                        <li class="flex gap-2">
                            <span>✉️</span>
                            <span>hello@tansorganic.com</span>
                        </li>
                        <li class="flex gap-2">
                            <span>🕐</span>
                            <span>Tue–Sat: 8am – 1pm</span>
                        </li>
                    </ul>
                </div>

            </div>

            <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row 
                        items-center justify-between gap-4 text-xs text-white/40">
                <p>© 2025 Tan's Organic Harvest. All rights reserved.</p>
                <p>Grown with ❤️ and no pesticides.</p>
            </div>
        </div>
    </footer>

</form>

<script>
    function toggleMobileMenu() {
        document.getElementById('mobileMenu').classList.toggle('hidden');
    }
</script>
</body>
</html>