<?xml version="1.0"?>
<configuration>
	<system.web>
		<authorization>
			<deny users="?" />
		</authorization>
	</system.web>

	<!-- eSewa success/failure callbacks come from eSewa's servers
       without our auth cookie — must be publicly accessible -->
	<location path="EsewaSuccess.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<location path="EsewaFailure.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>
</configuration>